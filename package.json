{
  "name": "ai-story-writer-agent",
  "version": "1.0.0",
  "description": "AI Story Writer Agent — generates JIRA-ready Scrum artifacts from PRDs",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/skill",
    "packages/service",
    "packages/hybrid"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --workspace",
    "test:watch": "vitest --workspace",
    "test:coverage": "vitest run --workspace --coverage",
    "lint": "eslint 'packages/*/src/**/*.ts'",
    "lint:fix": "eslint 'packages/*/src/**/*.ts' --fix",
    "format": "prettier --write 'packages/*/src/**/*.ts'",
    "format:check": "prettier --check 'packages/*/src/**/*.ts'",
    "typecheck": "tsc --build",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.4",
    "@vitest/coverage-v8": "^3.0.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
